---
import Logo from './Logo.astro';
import { AVISO_RIOT, CORREO_SOPORTE, URL_REPO, VERSION_ACTUAL } from '../lib/sitio';
import { GUIAS, IDIOMAS, INFO, ruta, t, type Idioma } from '../i18n';

interface Props {
  lang: Idioma;
}
const { lang } = Astro.props;
const tx = t(lang);
const e = tx.pie.enlaces;
const anio = 2026;
---

<footer class="pie">
  <div class="contenedor">
    <div class="pie-rejilla">
      <div class="pie-marca">
        <a class="marca" href={ruta(lang, 'inicio')}>
          <Logo tam={28} />
          <span>Coach LoL IA</span>
        </a>
        <p>{tx.pie.descripcion} {VERSION_ACTUAL}.</p>
        <p class="pie-soporte">
          {tx.pie.soporte}: <a href={`mailto:${CORREO_SOPORTE}`}>{CORREO_SOPORTE}</a>
        </p>
      </div>
      <nav aria-label={tx.pie.producto}>
        <h2>{tx.pie.producto}</h2>
        <ul>
          <li><a href={ruta(lang, 'descargar')}>{e.descargar}</a></li>
          <li><a href={ruta(lang, 'novedades')}>{e.novedades}</a></li>
          <li><a href={ruta(lang, 'apoyar')}>{e.apoyar}</a></li>
          <li><a href={ruta(lang, 'inicio', '#hoja-de-ruta')}>{e.hojaDeRuta}</a></li>
        </ul>
      </nav>
      <nav aria-label={tx.pie.recursos}>
        <h2>{tx.pie.recursos}</h2>
        <ul>
          <li><a href={ruta(lang, 'builds')}>{e.builds}</a></li>
          <li><a href={ruta(lang, 'guias')}>{e.guias}</a></li>
          {GUIAS.map((g) => <li><a href={ruta(lang, g)}>{tx.guias.articulos[g].h1}</a></li>)}
        </ul>
      </nav>
      <nav aria-label={tx.pie.proyecto}>
        <h2>{tx.pie.proyecto}</h2>
        <ul>
          <li><a href={ruta(lang, 'inicio', '#arquitectura')}>{e.arquitectura}</a></li>
          <li><a href={ruta(lang, 'inicio', '#seguridad')}>{e.seguridad}</a></li>
          <li><a href={ruta(lang, 'inicio', '#calidad')}>{e.calidad}</a></li>
          <li><a href={URL_REPO} rel="noopener">{e.github}</a></li>
        </ul>
      </nav>
      <nav aria-label={tx.pie.legal}>
        <h2>{tx.pie.legal}</h2>
        <ul>
          <li><a href={ruta(lang, 'privacidad')}>{e.privacidad}</a></li>
          <li><a href={ruta(lang, 'terminos')}>{e.terminos}</a></li>
          <li><a href={ruta(lang, 'cookies')}>{e.cookies}</a></li>
        </ul>
      </nav>
    </div>
    <nav class="pie-idiomas" aria-label={tx.pie.idiomas}>
      <ul>
        {
          IDIOMAS.map((l) => (
            <li>
              <a href={ruta(l, 'inicio')} hreflang={INFO[l].hreflang} lang={INFO[l].html} aria-current={l === lang ? 'true' : undefined}>
                {INFO[l].nombre}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="aviso-riot" lang={lang === 'es' ? undefined : 'es'}>{AVISO_RIOT}</p>
    <p class="pie-final">© {anio} Coach LoL IA. {tx.pie.marca}</p>
  </div>
</footer>

<style>
  .pie {
    border-top: 1px solid var(--borde);
    background: #080b15;
    padding: 56px 0 32px;
    font-size: 0.92rem;
  }
  .pie-rejilla {
    display: grid;
    grid-template-columns: 1.5fr repeat(4, 1fr);
    gap: 32px;
  }
  .marca {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    color: var(--texto);
    text-decoration: none;
    margin-bottom: 12px;
  }
  .pie-marca p {
    color: var(--texto-suave);
    max-width: 36ch;
  }
  .pie-soporte a {
    color: var(--dorado-claro);
  }
  .pie h2 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--texto-suave);
    margin-bottom: 12px;
  }
  .pie ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .pie li {
    margin: 6px 0;
  }
  .pie nav a {
    color: var(--texto);
    text-decoration: none;
  }
  .pie nav a:hover {
    color: var(--dorado-claro);
  }
  .pie-idiomas ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-top: 32px;
  }
  .pie-idiomas a {
    color: var(--texto-suave);
    font-size: 0.88rem;
  }
  .pie-idiomas a[aria-current] {
    color: var(--dorado-claro);
  }
  .aviso-riot {
    margin: 24px 0 8px;
    padding-top: 24px;
    border-top: 1px solid var(--borde);
    color: var(--texto-suave);
    font-size: 0.85rem;
  }
  .pie-final {
    color: var(--texto-suave);
    font-size: 0.82rem;
    margin: 0;
  }
  .pie nav li a {
    display: inline-block;
    padding: 3px 0;
  }
  @media (max-width: 1000px) {
    .pie-rejilla {
      grid-template-columns: repeat(3, 1fr);
    }
    .pie-marca {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 760px) {
    .pie-rejilla {
      grid-template-columns: 1fr 1fr;
    }
    .pie-marca {
      grid-column: 1 / -1;
    }
  }
</style>
