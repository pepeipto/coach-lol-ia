---
import { md, t, type Idioma } from '../i18n';
interface Props {
  lang?: Idioma;
}
const lang = Astro.props.lang ?? 'es';
const l = t(lang).legal;
---

<div class="nota nota-aviso plantilla" role="note">
  <Fragment set:html={md(l.plantilla, lang)} />
  <span class="actualizado">{l.actualizado}</span>
  {l.traduccion && <span class="actualizado">{l.traduccion}</span>}
</div>

<style>
  .plantilla {
    margin: 0 0 32px;
  }
  .actualizado {
    display: block;
    margin-top: 6px;
    color: var(--texto-suave);
    font-size: 0.88rem;
  }
</style>
