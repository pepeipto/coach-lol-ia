---
// Recreación en HTML de la vista Campeón de la app v2, con arte oficial de Data Dragon
// (parche 16.20, textos es_MX). Es una maqueta: se sustituirá por capturas reales.
import { url } from '../lib/sitio';

const i = (nombre: string) => url(`img/iconos/${nombre}.webp`);

const runasPrimarias = [
  { icono: 'runa-sabor-a-sangre', nombre: 'Sabor a Sangre' },
  { icono: 'runa-recuerdos-macabros', nombre: 'Recuerdos Macabros' },
  { icono: 'runa-cazador-definitivo', nombre: 'Cazador Definitivo' },
];
const runasSecundarias = [
  { icono: 'runa-flujo-de-mana', nombre: 'Anillo de Flujo de Maná' },
  { icono: 'runa-trascendencia', nombre: 'Trascendencia' },
];
const grupos = [
  { titulo: 'Iniciales', objetos: [['objeto-1056', 'Sortija de Doran'], ['objeto-2003', 'Poción de Vida']] },
  { titulo: 'Núcleo', objetos: [['objeto-6655', 'Eco de Luden'], ['objeto-4645', 'Lumbría'], ['objeto-3089', 'Sombrero Mortífero de Rabadon']], flechas: true },
  { titulo: 'Botas', objetos: [['objeto-3020', 'Botas del Hechicero']] },
  { titulo: 'Situacionales', objetos: [['objeto-3157', 'Reloj de Arena de Zhonya'], ['objeto-3135', 'Báculo del Vacío']] },
];
// Orden de habilidades por nivel (1-18): Q > W > E, R en 6, 11 y 16.
const orden = 'QWEQQRQWQWRWWEERE'.split('').concat('E');
const habilidades = [
  { tecla: 'Q', icono: 'ahri-q', nombre: 'Orbe del Engaño' },
  { tecla: 'W', icono: 'ahri-w', nombre: 'Fuego Zorruno' },
  { tecla: 'E', icono: 'ahri-e', nombre: 'Encanto' },
  { tecla: 'R', icono: 'ahri-r', nombre: 'Impulso Espiritual' },
];
const roles = ['TOP', 'JUN', 'MID', 'ADC', 'SUP'];
---

<div class="app" role="img" aria-label="Recreación de la vista Campeón de Coach LoL IA: Ahri en el rol Central con 52,4 % de victorias en 1.284 partidas de Esmeralda+, runas Electrocutar, Sabor a Sangre, Recuerdos Macabros y Cazador Definitivo con Anillo de Flujo de Maná y Trascendencia; objetos Sortija de Doran, Eco de Luden, Lumbría, Sombrero Mortífero de Rabadon y Botas del Hechicero; hechizos Destello e Ignición; orden de habilidades Q, W, E.">
  <div class="barra" aria-hidden="true">
    <span class="punto"></span><span class="titulo-ventana">Coach LoL IA</span>
    <span class="fase">Selección de campeón · Clasificatoria Solo/Dúo</span>
    <span class="controles"><i></i><i></i><i></i></span>
  </div>
  <div class="cuerpo" aria-hidden="true">
    <nav class="lateral">
      <span class="activo">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4" /><path d="M5 21a7 7 0 0 1 14 0" /></svg>
      </span>
      <span><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8" /></svg></span>
      <span><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3" /><path d="M12 2v3M12 19v3M2 12h3M19 12h3" /></svg></span>
      <span class="oro"><svg viewBox="0 0 24 24"><path d="m12 3 8 7-8 11-8-11Z" /></svg></span>
    </nav>
    <div class="principal">
      <header class="cabeza">
        <img class="arte" src={url('img/splash-ahri-800.webp')} alt="" width="800" height="472" loading="lazy" decoding="async" />
        <div class="cabeza-contenido">
          <img class="retrato" src={i('campeon-ahri')} alt="" width="64" height="64" />
          <div class="nombre">
            <strong>Ahri</strong>
            <span>la Vastaya de Nueve Colas</span>
          </div>
          <div class="roles">
            {roles.map((r) => <span class:list={{ activo: r === 'MID' }}>{r}</span>)}
          </div>
          <span class="importar">Importar</span>
        </div>
        <div class="stats">
          <span><b class="verde">52,4 %</b> victorias</span>
          <span><b>1.284</b> partidas</span>
          <span>Esmeralda+ · EUW, LAN, LAS</span>
        </div>
      </header>

      <div class="rejilla-app">
        <section class="tarj runas">
          <h4>Runas <small>Dominación · Brujería</small></h4>
          <div class="clave">
            <img src={i('runa-electrocutar')} alt="" width="52" height="52" />
            <div><strong>Electrocutar</strong><small>54,1 % de victorias</small></div>
          </div>
          <ul class="lista-runas">
            {runasPrimarias.map((r) => <li><img src={i(r.icono)} alt="" width="28" height="28" />{r.nombre}</li>)}
          </ul>
          <ul class="lista-runas secundarias">
            {runasSecundarias.map((r) => <li><img src={i(r.icono)} alt="" width="24" height="24" />{r.nombre}</li>)}
          </ul>
        </section>

        <section class="tarj objetos">
          <h4>Objetos <small>núcleo de 3</small></h4>
          <div class="grupos">
            {grupos.map((g) => (
              <div class="grupo">
                <small>{g.titulo}</small>
                <div class="iconos">
                  {g.objetos.map(([icono], k) => (
                    <>
                      {g.flechas && k > 0 && <span class="flecha">›</span>}
                      <img src={i(icono)} alt="" width="36" height="36" />
                    </>
                  ))}
                </div>
              </div>
            ))}
          </div>
          <div class="hechizos">
            <img src={i('hechizo-destello')} alt="" width="30" height="30" />
            <img src={i('hechizo-ignicion')} alt="" width="30" height="30" />
            <span>Destello + Ignición <small>86 % de las partidas</small></span>
          </div>
        </section>

        <section class="tarj habilidades">
          <h4>Orden de habilidades <small>Q › W › E</small></h4>
          <div class="tabla-hab">
            {habilidades.map((h) => (
              <div class="fila-hab">
                <span class="hab"><img src={i(h.icono)} alt="" width="26" height="26" /><b>{h.tecla}</b></span>
                {orden.map((t, n) => (
                  <span class:list={['celda', { marcada: t === h.tecla, ulti: t === 'R' && h.tecla === 'R' }]}>
                    {t === h.tecla ? n + 1 : ''}
                  </span>
                ))}
              </div>
            ))}
          </div>
        </section>
      </div>
      <footer class="estado">
        <span class="ok"></span> Datos del parche 16.20 · actualizado hace 2 h
      </footer>
    </div>
  </div>
</div>

<style>
  .app {
    container-type: inline-size;
    background: var(--fondo);
    border: 1px solid var(--borde);
    border-radius: 14px;
    overflow: hidden;
    font-size: 12px;
    color: var(--texto);
    box-shadow:
      0 40px 120px -40px rgb(79 124 255 / 0.45),
      var(--sombra);
  }
  .barra {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 30px;
    padding: 0 12px;
    background: #0d1222;
    border-bottom: 1px solid var(--borde);
    color: var(--texto-suave);
    font-size: 11px;
  }
  .punto {
    width: 10px;
    height: 10px;
    border: 2px solid var(--dorado);
    transform: rotate(45deg);
  }
  .titulo-ventana {
    color: var(--texto);
    font-weight: 600;
  }
  .fase {
    margin: 0 auto;
  }
  .controles {
    display: flex;
    gap: 10px;
  }
  .controles i {
    width: 9px;
    height: 9px;
    border: 1.5px solid var(--texto-suave);
    border-radius: 2px;
  }
  .cuerpo {
    display: flex;
  }
  .lateral {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 12px 8px;
    background: #0d1222;
    border-right: 1px solid var(--borde);
  }
  .lateral span {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    color: var(--texto-suave);
  }
  .lateral span.activo {
    background: var(--superficie-2);
    color: var(--dorado);
    box-shadow: inset 2px 0 0 var(--dorado);
  }
  .lateral span.oro {
    color: var(--dorado);
  }
  .lateral svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }
  .principal {
    flex: 1;
    min-width: 0;
  }
  .cabeza {
    position: relative;
    padding: 70px 16px 12px;
    overflow: hidden;
  }
  .arte {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 20%;
  }
  .cabeza::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(10 14 26 / 0.05) 0%, rgb(10 14 26 / 0.55) 55%, var(--fondo) 100%),
      linear-gradient(90deg, rgb(10 14 26 / 0.7), transparent 60%);
  }
  .cabeza-contenido,
  .stats {
    position: relative;
    z-index: 1;
  }
  .cabeza-contenido {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .retrato {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    border: 2px solid var(--dorado);
  }
  .nombre {
    display: grid;
    margin-right: auto;
  }
  .nombre strong {
    font-size: 24px;
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .nombre span {
    color: #c9d0e2;
    font-size: 11px;
  }
  .roles {
    display: flex;
    gap: 2px;
    padding: 3px;
    background: rgb(18 24 41 / 0.85);
    border: 1px solid var(--borde);
    border-radius: 8px;
  }
  .roles span {
    padding: 4px 7px;
    border-radius: 6px;
    color: var(--texto-suave);
    font-size: 10px;
    font-weight: 700;
  }
  .roles span.activo {
    background: var(--superficie-2);
    color: var(--dorado);
    box-shadow: inset 0 0 0 1px rgb(200 170 110 / 0.5);
  }
  .importar {
    padding: 8px 14px;
    border-radius: 8px;
    background: linear-gradient(180deg, var(--dorado-claro), var(--dorado));
    color: #14110a;
    font-weight: 700;
  }
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin-top: 10px;
    color: #c9d0e2;
    font-size: 11px;
  }
  .verde {
    color: var(--exito);
  }
  .rejilla-app {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 10px;
    padding: 4px 12px 12px;
  }
  .tarj {
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-radius: 10px;
    padding: 10px 12px;
  }
  .tarj h4 {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin: 0 0 8px;
    font-size: 12.5px;
  }
  .tarj h4 small,
  .tarj small {
    color: var(--texto-suave);
    font-weight: 500;
    font-size: 10.5px;
  }
  .clave {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }
  .clave img {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--superficie-2);
    box-shadow: 0 0 0 2px rgb(200 170 110 / 0.6);
  }
  .clave div {
    display: grid;
  }
  .lista-runas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 5px;
  }
  .lista-runas li {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .lista-runas img {
    width: 24px;
    height: 24px;
  }
  .secundarias {
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px solid var(--borde);
  }
  .secundarias img {
    width: 20px;
    height: 20px;
  }
  .grupos {
    display: grid;
    grid-template-columns: auto auto;
    gap: 8px 14px;
    justify-content: start;
  }
  .grupo .iconos {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: 3px;
  }
  .grupo img {
    width: 32px;
    height: 32px;
    border-radius: 6px;
    border: 1px solid rgb(200 170 110 / 0.45);
  }
  .flecha {
    color: var(--texto-suave);
  }
  .hechizos {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
    padding-top: 8px;
    border-top: 1px solid var(--borde);
  }
  .hechizos img {
    width: 28px;
    height: 28px;
    border-radius: 6px;
  }
  .hechizos span {
    display: grid;
    margin-left: 4px;
  }
  .habilidades {
    grid-column: 1 / -1;
  }
  .tabla-hab {
    display: grid;
    gap: 3px;
  }
  .fila-hab {
    display: grid;
    grid-template-columns: 40px repeat(18, minmax(0, 1fr));
    gap: 3px;
    align-items: center;
  }
  .hab {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .hab img {
    width: 20px;
    height: 20px;
    border-radius: 4px;
  }
  .hab b {
    font-size: 10px;
    color: var(--texto-suave);
  }
  .celda {
    height: 18px;
    border-radius: 4px;
    background: var(--superficie-2);
    font-size: 9.5px;
    font-weight: 700;
    display: grid;
    place-items: center;
  }
  .celda.marcada {
    background: rgb(79 124 255 / 0.85);
    color: #fff;
  }
  .celda.ulti {
    background: linear-gradient(180deg, var(--dorado-claro), var(--dorado));
    color: #14110a;
  }
  .estado {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px 10px;
    color: var(--texto-suave);
    font-size: 11px;
    border-top: 1px solid var(--borde);
  }
  .ok {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--exito);
  }

  @container (max-width: 520px) {
    .lateral,
    .fase,
    .roles {
      display: none;
    }
    .cabeza {
      padding-top: 56px;
    }
    .rejilla-app {
      grid-template-columns: 1fr;
    }
    .fila-hab {
      grid-template-columns: 30px repeat(18, minmax(0, 1fr));
      gap: 2px;
    }
    .celda {
      height: 15px;
      font-size: 8px;
    }
    .hab b {
      display: none;
    }
  }
</style>
