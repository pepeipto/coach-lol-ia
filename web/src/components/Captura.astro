---
// Captura real de la app (public/capturas/<nombre>.webp a 1600 px y <nombre>-800.webp).
import { url } from '../lib/sitio';

interface Props {
  nombre: string;
  alt: string;
  pie?: string;
  prioridad?: boolean;
  sizes?: string;
  clase?: string;
}
const { nombre, alt, pie, prioridad = false, sizes = '(max-width: 1000px) 100vw, 640px', clase } = Astro.props;
---

<figure class:list={['captura', clase]}>
  <div class="marco">
    <img
      src={url(`capturas/${nombre}.webp`)}
      srcset={`${url(`capturas/${nombre}-800.webp`)} 800w, ${url(`capturas/${nombre}.webp`)} 1600w`}
      sizes={sizes}
      width="1600"
      height="1000"
      alt={alt}
      decoding="async"
      loading={prioridad ? 'eager' : 'lazy'}
      fetchpriority={prioridad ? 'high' : 'auto'}
    />
  </div>
  {
    pie && (
      <figcaption>
        <span class="etiqueta etiqueta-exito">Captura real</span> {pie}
      </figcaption>
    )
  }
</figure>

<style>
  .captura {
    margin: 0;
  }
  .marco {
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgb(200 170 110 / 0.35);
    background: var(--fondo);
    box-shadow:
      0 0 0 6px rgb(18 24 41 / 0.7),
      0 40px 120px -40px rgb(79 124 255 / 0.45),
      var(--sombra);
  }
  img {
    display: block;
    width: 100%;
    height: auto;
  }
  figcaption {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    color: var(--texto-suave);
    font-size: 0.86rem;
    margin-top: 16px;
  }
</style>
