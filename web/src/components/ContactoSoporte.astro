---
import { CORREO_SOPORTE } from '../lib/sitio';
import { t, type Idioma } from '../i18n';
interface Props {
  titulo?: string;
  lang?: Idioma;
}
const c = t(Astro.props.lang ?? 'es').comun;
const { titulo = c.ayudaTitulo } = Astro.props;
---

<aside class="contacto tarjeta" aria-label={c.soporteAria}>
  <h2>{titulo}</h2>
  <p><slot>{c.ayudaTexto}</slot></p>
  <a class="boton boton-borde" href={`mailto:${CORREO_SOPORTE}`}>{CORREO_SOPORTE}</a>
</aside>

<style>
  .contacto {
    margin-top: 40px;
    display: grid;
    gap: 6px;
    justify-items: start;
  }
  .contacto h2 {
    font-size: 1.15rem;
    margin: 0;
  }
  .contacto p {
    margin: 0 0 10px;
  }
</style>
