---
interface Props {
  tam?: number;
}
const { tam = 32 } = Astro.props;
---

<svg width={tam} height={tam} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="logo-oro" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#e2c98f" />
      <stop offset="1" stop-color="#a8884b" />
    </linearGradient>
  </defs>
  <path d="M32 3 57 17.5v29L32 61 7 46.5v-29Z" fill="#121829" stroke="url(#logo-oro)" stroke-width="3" />
  <path d="M42.5 23.5A13 13 0 1 0 42.5 40.5" fill="none" stroke="url(#logo-oro)" stroke-width="5" stroke-linecap="round" />
  <path d="m37 26 8 6-8 6" fill="none" stroke="#4f7cff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
</svg>
