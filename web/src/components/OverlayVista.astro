---
// Recreación del overlay en partida sobre arte oficial (maqueta; no es una captura del juego).
import { url } from '../lib/sitio';
const i = (nombre: string) => url(`img/iconos/${nombre}.webp`);
---

<div class="escena" role="img" aria-label="Recreación del overlay en partida: un panel compacto con la próxima compra, Eco de Luden por 1900 de oro, y el próximo objetivo, el dragón en 60 segundos, y un aviso emergente que dice «Nivel 4: sube la Q».">
  <img class="fondo" src={url('img/splash-jinx-800.webp')} srcset={`${url('img/splash-jinx-800.webp')} 800w, ${url('img/splash-jinx.webp')} 1600w`} sizes="(max-width: 1000px) 100vw, 640px" alt="" width="800" height="472" loading="lazy" decoding="async" />
  <div class="velo" aria-hidden="true"></div>

  <div class="panel" aria-hidden="true">
    <div class="panel-cab">
      <span class="marca"><i></i>COACH</span>
      <span class="atajo">Ctrl+Mayús+O</span>
    </div>
    <div class="fila">
      <img src={i('objeto-6655')} alt="" width="34" height="34" />
      <div><small>Próxima compra</small><strong>Eco de Luden (1900 de oro)</strong></div>
    </div>
    <div class="fila">
      <span class="icono-obj">
        <svg viewBox="0 0 24 24"><path d="M4 18c3-1 4-4 4-8 2 2 3 2 4 0 1 2 2 2 4 0 0 4 1 7 4 8" /><circle cx="12" cy="7" r="2" /></svg>
      </span>
      <div><small>Próximo objetivo</small><strong>El dragón aparece en 60 s</strong></div>
    </div>
  </div>

  <div class="aviso" aria-hidden="true">
    <img src={i('ahri-q')} alt="" width="34" height="34" />
    <strong>Nivel 4: sube la Q</strong>
    <span class="voz">
      <svg viewBox="0 0 24 24"><path d="M11 5 6 9H2v6h4l5 4V5Z" /><path d="M15.5 8.5a5 5 0 0 1 0 7" /></svg>
    </span>
  </div>

  <div class="aviso aviso-2" aria-hidden="true">
    <img src={i('objeto-2055')} alt="" width="34" height="34" />
    <strong>No llevas guardianes de control</strong>
  </div>
</div>

<style>
  .escena {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--borde);
    box-shadow: var(--sombra);
    container-type: inline-size;
  }
  .fondo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 30%;
  }
  .velo {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(10 14 26 / 0.35), rgb(10 14 26 / 0.15) 40%, rgb(10 14 26 / 0.65)),
      linear-gradient(90deg, rgb(10 14 26 / 0.55), transparent 55%);
  }
  .panel {
    position: absolute;
    top: 5%;
    left: 4%;
    width: min(62%, 300px);
    background: rgb(10 14 26 / 0.86);
    border: 1px solid var(--borde);
    border-radius: 12px;
    padding: 10px 12px;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .panel-cab {
    display: flex;
    justify-content: space-between;
    margin-bottom: 6px;
    font-size: 10.5px;
  }
  .marca {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--dorado);
    font-weight: 800;
    letter-spacing: 0.14em;
  }
  .marca i {
    width: 8px;
    height: 8px;
    border: 2px solid var(--dorado);
    transform: rotate(45deg);
  }
  .atajo {
    color: var(--texto-suave);
  }
  .fila {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 6px 0;
    border-top: 1px solid rgb(38 49 77 / 0.7);
  }
  .fila img,
  .icono-obj {
    width: 30px;
    height: 30px;
    border-radius: 6px;
    flex-shrink: 0;
  }
  .icono-obj {
    display: grid;
    place-items: center;
    background: rgb(240 180 41 / 0.12);
    color: var(--aviso);
  }
  .icono-obj svg,
  .voz svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }
  .fila div {
    display: grid;
    line-height: 1.3;
  }
  .fila small {
    color: var(--texto-suave);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .fila strong {
    font-size: 13px;
  }
  .aviso {
    position: absolute;
    right: 4%;
    top: 8%;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px 8px 8px;
    background: rgb(18 24 41 / 0.92);
    border: 1px solid rgb(79 124 255 / 0.65);
    border-left: 4px solid var(--primario);
    border-radius: 10px;
    font-size: 14px;
    animation: entrar 6s ease-in-out infinite;
  }
  .aviso img {
    width: 30px;
    height: 30px;
    border-radius: 6px;
  }
  .aviso-2 {
    top: auto;
    bottom: 7%;
    right: auto;
    left: 4%;
    border-color: rgb(240 180 41 / 0.6);
    border-left-color: var(--aviso);
    font-size: 13px;
    animation-delay: 3s;
  }
  .voz {
    color: var(--texto-suave);
    display: grid;
  }
  @keyframes entrar {
    0%,
    100% {
      opacity: 0.25;
      transform: translateY(-4px);
    }
    15%,
    70% {
      opacity: 1;
      transform: none;
    }
  }
  @container (max-width: 480px) {
    .panel {
      width: 70%;
      padding: 6px 8px;
    }
    .fila {
      padding: 3px 0;
    }
    .fila strong {
      font-size: 11px;
    }
    .fila img,
    .icono-obj {
      width: 22px;
      height: 22px;
    }
    .aviso {
      top: auto;
      bottom: 26%;
      right: 4%;
      font-size: 12px;
      padding: 5px 8px 5px 5px;
    }
    .aviso img {
      width: 22px;
      height: 22px;
    }
    .aviso-2 {
      bottom: 6%;
      font-size: 11px;
    }
    .panel-cab .atajo {
      display: none;
    }
  }
</style>
