---
// Banner de consentimiento. Solo se incluye cuando hay anuncios configurados
// (PUBLIC_ADSENSE_CLIENT) y nunca en las páginas de pago. AdSense solo se
// inyecta después de que el usuario pulse «Aceptar» (o si ya lo aceptó antes).
import { ruta, t, type Idioma } from '../i18n';
interface Props {
  cliente: string;
  lang: Idioma;
}
const { cliente, lang } = Astro.props;
const tx = t(lang).cookies;
---

<div id="banner-cookies" class="banner-cookies" role="region" aria-label={tx.region} hidden>
  <div class="banner-texto">
    <strong>{tx.titulo}</strong>
    <p>
      {tx.texto} <a href={ruta(lang, 'cookies')}>{tx.enlace}</a>.
    </p>
  </div>
  <div class="banner-botones">
    <button type="button" class="boton boton-borde" data-cookies="rechazadas">{tx.rechazar}</button>
    <button type="button" class="boton boton-borde" data-cookies="aceptadas">{tx.aceptar}</button>
  </div>
</div>

<script is:inline define:vars={{ cliente }}>
  (function () {
    // La elección se guarda con su fecha y la versión de la política: si cambia la versión (nuevos fines o
    // proveedores) o pasan 12 meses, se vuelve a preguntar.
    var CLAVE = 'coach-cookies';
    var VERSION = '2026-11';
    var CADUCIDAD_MS = 365 * 24 * 3600 * 1000;
    var banner = document.getElementById('banner-cookies');
    function leer() {
      try {
        var g = JSON.parse(localStorage.getItem(CLAVE) || 'null');
        if (!g || g.version !== VERSION || !(Date.now() - g.fecha < CADUCIDAD_MS)) return null;
        return g.valor === 'aceptadas' || g.valor === 'rechazadas' ? g.valor : null;
      } catch (e) { return null; }
    }
    function guardar(valor) {
      try { localStorage.setItem(CLAVE, JSON.stringify({ valor: valor, version: VERSION, fecha: Date.now() })); } catch (e) {}
    }
    // Borra las cookies de publicidad de Google que el sitio puede ver (las de terceros las borra el navegador).
    function borrarCookiesAnuncios() {
      var nombres = ['__gads', '__gpi', '__eoi', '__gsas'];
      var partes = location.hostname.split('.');
      var dominios = ['', location.hostname];
      for (var i = 1; i < partes.length - 1; i++) dominios.push('.' + partes.slice(i).join('.'));
      nombres.forEach(function (n) {
        dominios.forEach(function (d) {
          document.cookie = n + '=; Max-Age=0; path=/' + (d ? '; domain=' + d : '');
        });
      });
    }
    window.__coachRetirarCookies = function () {
      try { localStorage.removeItem(CLAVE); } catch (e) {}
      borrarCookiesAnuncios();
      // Con los anuncios ya cargados, recargar es la única forma de pararlos: la página vuelve sin AdSense.
      if (window.__coachAnuncios) { location.reload(); return true; }
      return false;
    };
    function cargarAnuncios() {
      if (window.__coachAnuncios) return;
      var espacios = document.querySelectorAll('.anuncio');
      if (!espacios.length) return;
      window.__coachAnuncios = true;
      var s = document.createElement('script');
      s.async = true;
      s.crossOrigin = 'anonymous';
      s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + encodeURIComponent(cliente);
      document.head.appendChild(s);
      espacios.forEach(function (espacio) {
        espacio.hidden = false;
        try { (window.adsbygoogle = window.adsbygoogle || []).push({}); } catch (e) {}
      });
    }
    var eleccion = leer();
    if (eleccion === 'aceptadas') cargarAnuncios();
    else if (!eleccion) banner.hidden = false;
    banner.addEventListener('click', function (e) {
      var boton = e.target.closest('[data-cookies]');
      if (!boton) return;
      var valor = boton.getAttribute('data-cookies');
      guardar(valor);
      banner.hidden = true;
      if (valor === 'aceptadas') cargarAnuncios();
      else {
        borrarCookiesAnuncios();
        // Rechazar después de haber aceptado en esta misma página: se recarga para detener AdSense.
        if (window.__coachAnuncios) location.reload();
      }
    });
  })();
</script>

<style>
  .banner-cookies {
    position: fixed;
    left: 16px;
    right: 16px;
    bottom: 16px;
    z-index: 60;
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    gap: 20px;
    align-items: center;
    background: var(--superficie-2);
    border: 1px solid var(--borde);
    border-radius: var(--radio-grande);
    box-shadow: var(--sombra);
    padding: 18px 20px;
  }
  .banner-texto p {
    margin: 4px 0 0;
    color: var(--texto-suave);
    font-size: 0.9rem;
  }
  .banner-botones {
    display: flex;
    gap: 10px;
    flex-shrink: 0;
  }
  @media (max-width: 640px) {
    .banner-cookies {
      flex-direction: column;
      align-items: stretch;
    }
    .banner-botones .boton {
      flex: 1;
    }
  }
</style>
