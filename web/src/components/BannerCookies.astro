---
// Banner de consentimiento. Solo se incluye cuando hay anuncios configurados
// (PUBLIC_ADSENSE_CLIENT) y nunca en las páginas de pago.
---

<div id="banner-cookies" class="banner-cookies" role="region" aria-label="Consentimiento de cookies" hidden>
  <div class="banner-texto">
    <strong>Cookies y publicidad</strong>
    <p>
      Esta web muestra anuncios de Google AdSense, que usan cookies de terceros. Solo se cargan si
      los aceptas. Puedes cambiar de opinión en cualquier momento desde la página de
      <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/cookies`}>cookies</a>.
    </p>
  </div>
  <div class="banner-botones">
    <button type="button" class="boton boton-borde" data-cookies="rechazadas">Rechazar</button>
    <button type="button" class="boton boton-borde" data-cookies="aceptadas">Aceptar</button>
  </div>
</div>

<script is:inline>
  (function () {
    var CLAVE = 'coach-cookies';
    var banner = document.getElementById('banner-cookies');
    function leer() {
      try { return localStorage.getItem(CLAVE); } catch (e) { return null; }
    }
    function guardar(valor) {
      try { localStorage.setItem(CLAVE, valor); } catch (e) {}
    }
    window.coachConsentimiento = leer;
    if (!leer()) banner.hidden = false;
    banner.addEventListener('click', function (e) {
      var boton = e.target.closest('[data-cookies]');
      if (!boton) return;
      var valor = boton.getAttribute('data-cookies');
      guardar(valor);
      banner.hidden = true;
      document.dispatchEvent(new CustomEvent('coach:cookies', { detail: valor }));
    });
  })();
</script>

<style>
  .banner-cookies {
    position: fixed;
    left: 16px;
    right: 16px;
    bottom: 16px;
    z-index: 60;
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    gap: 20px;
    align-items: center;
    background: var(--superficie-2);
    border: 1px solid var(--borde);
    border-radius: var(--radio-grande);
    box-shadow: var(--sombra);
    padding: 18px 20px;
  }
  .banner-texto p {
    margin: 4px 0 0;
    color: var(--texto-suave);
    font-size: 0.9rem;
  }
  .banner-botones {
    display: flex;
    gap: 10px;
    flex-shrink: 0;
  }
  @media (max-width: 640px) {
    .banner-cookies {
      flex-direction: column;
      align-items: stretch;
    }
    .banner-botones .boton {
      flex: 1;
    }
  }
</style>
