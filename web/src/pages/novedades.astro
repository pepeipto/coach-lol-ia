---
// Novedades: se generan al compilar a partir de CHANGELOG.md, en la raíz del repositorio.
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import { URL_RELEASES, url } from '../lib/sitio';
import { fechaLarga, leerNovedades, trozos } from '../lib/novedades';

const versiones = leerNovedades();
const [ultima] = versiones;
---

<Base titulo="Novedades" descripcion="Todas las versiones de Coach LoL IA y lo que trae cada una, de la más reciente a la más antigua.">
  <section class="pagina">
    <div class="contenedor">
      <span class="antetitulo">Novedades</span>
      <h1>Qué hay de nuevo en Coach LoL IA</h1>
      <p class="intro">
        Todas las versiones de la app, de la más reciente a la más antigua. La app las enseña también en su vista
        «Novedades» y te resume cada versión nueva la primera vez que la abres.
      </p>

      <ol class="versiones">
        {
          versiones.map((v) => (
            <li class:list={['tarjeta', 'version', { 'version-ultima': v === ultima }]} id={`v${v.version}`}>
              <div class="version-cabecera">
                <h2>Versión {v.version}</h2>
                {v === ultima && <span class="etiqueta etiqueta-dorada">Última versión</span>}
                <time datetime={v.fecha}>{fechaLarga(v.fecha)}</time>
              </div>
              <ul class="lista-check">
                {v.puntos.map((p) => (
                  <li>{trozos(p).map((t) => (t.codigo ? <code>{t.texto}</code> : t.texto))}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>

      <div class="cierre tarjeta">
        <p>Las actualizaciones se instalan solas al cerrar la app. Si aún no la tienes, descárgala gratis.</p>
        <div class="botones">
          <a class="boton boton-primario" href={url('descargar')}><Icono nombre="descarga" tam={20} /> Descargar para Windows</a>
          <a class="boton boton-borde" href={URL_RELEASES} rel="noopener">Notas en GitHub</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .versiones {
    list-style: none;
    padding: 0;
    margin: 36px 0 0;
    display: grid;
    gap: 18px;
    max-width: 900px;
  }
  .version-ultima {
    border-color: rgb(200 170 110 / 0.5);
    background:
      radial-gradient(80% 140% at 100% 0%, rgb(200 170 110 / 0.1), transparent 60%),
      var(--superficie);
  }
  .version-cabecera {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 14px;
    margin-bottom: 10px;
  }
  .version-cabecera h2 {
    font-size: 1.35rem;
    margin: 0;
  }
  .version-cabecera time {
    color: var(--texto-suave);
    font-size: 0.9rem;
  }
  .version li {
    color: #c9d0e2;
    font-size: 0.96rem;
    overflow-wrap: break-word;
  }
  .cierre {
    margin-top: 40px;
    max-width: 900px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .cierre p {
    margin: 0;
    color: var(--texto-suave);
  }
  .botones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  @media (max-width: 640px) {
    .botones .boton {
      width: 100%;
    }
  }
</style>
