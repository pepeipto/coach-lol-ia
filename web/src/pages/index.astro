---
import Base from '../layouts/Base.astro';
import Seccion from '../components/Seccion.astro';
import Icono from '../components/Icono.astro';
import DiagramaArquitectura from '../components/DiagramaArquitectura.astro';
import Captura from '../components/Captura.astro';
import Anuncio from '../components/Anuncio.astro';
import { CORREO_SOPORTE, LEMA, MIN_PARTIDAS_BUILD, PARTIDAS_DATOS_LIMITADOS, PRUEBAS_AUTOMATICAS, URL_REPO, url } from '../lib/sitio';

const fondos = ['ahri', 'jinx', 'lux', 'yasuo'];

const funciones = [
  {
    icono: 'capas',
    titulo: 'Builds por campeón y rol',
    texto:
      'Runas, hechizos, objetos iniciales, núcleo de 3 objetos, botas, situacionales y orden de habilidades, con su porcentaje de victorias y el número de partidas que lo respaldan. Se publican desde 10 partidas; las que tienen pocas llevan la insignia «Datos limitados».',
  },
  {
    icono: 'grafico',
    titulo: 'Campeones y tier list',
    texto:
      'El apartado Campeones ordena a todos los campeones por rol en los tiers S, A, B y C según sus victorias y su uso, con búsqueda y la build completa de cada uno.',
  },
  {
    icono: 'usuario',
    titulo: 'Pantalla de carga',
    texto:
      'Mientras carga la partida, el overlay enseña a los diez jugadores: rango oficial, maestría y victorias del campeón en su rol, con etiquetas solo positivas o neutras.',
  },
  {
    icono: 'descarga',
    titulo: 'Importación en un clic',
    texto:
      'Crea la página de runas «Coach: <Campeón> <Rol>», elige los hechizos y añade un conjunto de objetos a la tienda. Solo toca páginas con el prefijo «Coach:»; nunca borra las tuyas.',
  },
  {
    icono: 'brujula',
    titulo: 'Rol automático',
    texto:
      'Toma el rol que te asigna el cliente. Si no hay ninguno, usa el más jugado con ese campeón, y puedes cambiarlo con el selector de rol.',
  },
  {
    icono: 'monitor',
    titulo: 'Overlay por widgets',
    texto:
      'Barra de objetivos arriba (con el tipo del próximo dragón), una flecha sobre la habilidad que toca subir, tu CS y tu KDA, el aviso de compra y los avisos. Cada widget se mueve, se escala y se apaga por separado.',
  },
  {
    icono: 'voz',
    titulo: 'Mucha más voz',
    texto:
      'Objetivos, compras, habilidades, CS, visión, fases de la partida y jungla, de una frase en una y la más urgente primero. Eliges la voz, el volumen y qué avisos quieres oír.',
  },
  {
    icono: 'reloj',
    titulo: 'Temporizadores de jungla',
    texto:
      'Opcionales y apagados por defecto: marcas tú cuándo limpias un campamento de tu lado o un Escarabajo y la app cuenta su reaparición, también encima del minimapa.',
  },
  {
    icono: 'diana',
    titulo: 'ARAM, ARAM: Caos y Arena',
    texto:
      'Cada modo con sus builds y su tier list (con aumentos en ARAM: Caos y Arena), y un overlay que en cada modo enseña solo lo que tiene sentido.',
  },
  {
    icono: 'nube',
    titulo: 'Funciona sin conexión',
    texto:
      'Guarda en caché las últimas builds. Si el servidor no responde, la app usa la copia guardada y te lo indica: «Datos sin conexión (parche X)».',
  },
  {
    icono: 'refrescar',
    titulo: 'Se actualiza sola',
    texto:
      'El instalador de Windows descarga las nuevas versiones desde GitHub Releases y las instala al cerrar la app. Data Dragon y las builds siguen el parche actual.',
  },
  {
    icono: 'idioma',
    titulo: 'Todo en español',
    texto:
      'Interfaz, overlay, errores y voz en español neutro, con todos los textos en un único archivo de idioma para poder traducirla en el futuro.',
  },
] as const;

const pasos = [
  {
    titulo: 'Abre la app y el cliente de LoL',
    texto:
      'Coach LoL IA localiza el cliente leyendo su archivo lockfile (puerto y contraseña locales). Mientras no lo encuentra muestra «Esperando al cliente de League of Legends…» y lo vuelve a intentar cada 3 segundos.',
    detalle: 'LCU API · WebSocket',
  },
  {
    titulo: 'Elige campeón',
    texto:
      'El cliente avisa por WebSocket del campeón y el rol. La app pide la build al servidor y la muestra en menos de 2 segundos. Con «Importar» (o con la importación automática) aplica runas, hechizos y objetos.',
    detalle: 'Selección de campeón',
  },
  {
    titulo: 'Juega con el coach',
    texto:
      'Mientras carga, el overlay enseña la pantalla de carga con los dos equipos. Ya en partida, la app consulta la Live Client Data API en https://127.0.0.1:2999 cada segundo. El motor de consejos compara tu estado con la build y muestra los objetivos, la habilidad que toca subir, tu CS y tu KDA, la próxima compra y los avisos. Ctrl+Mayús+O lo oculta o lo muestra.',
    detalle: 'Live Client Data API',
  },
  {
    titulo: 'Fin de la partida',
    texto:
      'Cuando la partida termina, el overlay se oculta y la app deja de consultar el puerto 2999. La siguiente selección de campeón vuelve a empezar el ciclo.',
    detalle: 'Sin procesos residuales',
  },
];

const avisos = [
  ['Compra', '«Puedes comprar Huracán de Runaan»'],
  ['Habilidades', '«Nivel 6: sube la R»'],
  ['Objetivos', 'A 1 minuto, a 30 segundos y al aparecer, con el tipo de dragón'],
  ['CS', '«Vas por debajo del objetivo de CS» (una vez, en el minuto 10)'],
  ['Visión', '«Compra un guardián de control»'],
  ['Jungla', '«El Gromp en 30 segundos» (solo si usas los temporizadores)'],
  ['Jungla enemiga', '«El jungla enemigo acaba de aparecer en bot (kill)»'],
  ['Fase de partida', '«Fase media: agrupa con tu equipo para los objetivos»'],
];

const tecnologias = [
  { nombre: 'Electron', uso: 'App de escritorio: ventana principal y overlay transparente con clics pasantes.' },
  { nombre: 'React 19', uso: 'Interfaz de las dos ventanas, con CSS propio basado en tokens de diseño.' },
  { nombre: 'TypeScript', uso: 'Todo el código (app, servidor y tipos compartidos) con comprobación estricta.' },
  { nombre: 'Node.js 24', uso: 'Proceso principal de la app y servidor de builds.' },
  { nombre: 'SQLite', uso: 'Base de datos del servidor (better-sqlite3): partidas y builds.' },
  { nombre: 'Fastify', uso: 'API HTTP del servidor: builds, roles y el asistente IA.' },
  { nombre: 'Vitest', uso: 'Pruebas automáticas de la app, el servidor y el código compartido.' },
  { nombre: 'Astro', uso: 'Esta web: estática, sin frameworks en el cliente y publicada en GitHub Pages.' },
  { nombre: 'electron-builder', uso: 'Instalador para Windows y actualizaciones automáticas desde GitHub Releases.' },
  { nombre: 'Docker', uso: 'Imagen del servidor lista para desplegar en cualquier alojamiento.' },
  { nombre: 'GitHub Actions', uso: 'Integración continua y despliegue de la web.' },
];

const hojaDeRuta = [
  {
    version: 'v1',
    estado: 'Completada',
    clase: 'etiqueta-exito',
    puntos: [
      'Builds de Esmeralda+ (EUW, LAN, LAS) con servidor propio',
      'Importación de runas, hechizos y objetos en un clic',
      'Overlay con avisos en español y voz opcional',
      'Instalador de Windows con actualizaciones automáticas',
      'Simulador de partida y LCU simulado para las pruebas',
    ],
  },
  {
    version: 'v2',
    estado: 'Completada',
    clase: 'etiqueta-exito',
    puntos: [
      'Interfaz nueva de estilo profesional: arte del campeón, tarjetas y microanimaciones',
      'Esta web del producto',
      'Asistente IA de soporte en la web y en la app',
      'Todo gratis para todos, sin anuncios dentro de la app',
    ],
  },
  {
    version: 'v3',
    estado: 'Nueva',
    clase: 'etiqueta-dorada',
    puntos: [
      'Overlay por widgets: objetivos, flecha de habilidad, CS y KDA, compra y avisos',
      'Pantalla de carga con rango, maestría y victorias del campeón',
      'Temporizadores de jungla manuales de tu lado, también sobre el minimapa',
      'Apartado Campeones con tier list, y modos ARAM, ARAM: Caos y Arena',
      'Más builds (desde 10 partidas), mucha más voz, bienvenida y Novedades',
    ],
  },
  {
    version: 'Después',
    estado: 'Ideas',
    clase: '',
    puntos: [
      'Análisis de la partida al terminar, con IA',
      'Más idiomas',
      'Cuentas de usuario y avisos por correo',
    ],
  },
];

const faq = [
  {
    p: '¿Me pueden sancionar por usar Coach LoL IA?',
    r: 'La app solo usa las API locales oficiales que Riot ofrece a herramientas de terceros (LCU API y Live Client Data API) y nunca toca el proceso del juego: no lee memoria, no inyecta código, no captura la pantalla y no simula teclas ni clics. Además, el overlay no muestra información que no veas ya en pantalla. Aun así, la decisión final sobre herramientas de terceros es siempre de Riot, y por eso revisamos cada aviso frente a su política vigente.',
  },
  {
    p: '¿Es gratis?',
    r: 'Sí, todo: las builds, las runas, la importación y el coach en partida (overlay y voz), para todo el mundo y sin anuncios dentro de la app. El proyecto se financia con anuncios en la web y donaciones voluntarias.',
  },
  {
    p: '¿Por qué no veo el overlay durante la partida?',
    r: 'El overlay es una ventana de Windows encima del juego, así que solo se ve si LoL está en modo «Sin bordes» (Opciones → Vídeo → Modo de ventana). Si el juego está en pantalla completa, la app te avisa. Durante la partida lo ocultas o lo muestras con Ctrl+Mayús+O. Para colocar cada widget, en la vista Overlay de la app pulsa «Mover y calibrar», arrástralo y pulsa «Fijar aquí» (o Esc o Ctrl+Mayús+O). Desde esa vista también activas, escalas o apagas cada widget.',
  },
  {
    p: '¿Cómo funcionan los temporizadores de jungla?',
    r: 'Son manuales y vienen apagados: los activas en la vista Overlay. Cuando limpias un campamento de tu lado o un Escarabajo, lo marcas con un clic o con una tecla que tú eliges, y la app cuenta cuánto le falta para reaparecer, en un widget y encima del minimapa. Con Alt+Mayús+L los muestras u ocultas durante la partida. Solo cuentan tu jungla y los Escarabajos, nunca los campamentos del rival: la app no sabe cuándo los limpia, y las políticas de Riot no permiten seguir lo que hace el enemigo fuera de tu vista.',
  },
  {
    p: '¿Qué enseña la pantalla de carga?',
    r: 'Mientras carga la partida, el overlay muestra a los diez jugadores con su campeón y su rol: el rango oficial de Solo/Dúo, la maestría con ese campeón y el porcentaje de victorias del campeón en su rol según nuestras builds. Añade etiquetas solo positivas o neutras, como «Especialista en Ahri» o «Escala a final de partida». No calcula un MMR propio ni pone etiquetas negativas a nadie, y se oculta en cuanto empieza la partida.',
  },
  {
    p: '¿Qué me dice del jungla enemigo?',
    r: 'Solo lo que el juego ya te enseña. Cuando el jungla enemigo participa en una muerte, que sale en el registro de muertes, la app te avisa: «El jungla enemigo acaba de aparecer en bot (kill)». Hay además una opción, apagada por defecto, con su ruta habitual: una estimación de nuestras partidas sobre por qué lado suele empezar ese campeón y a qué calle suele ir primero. Ninguna de las dos dice dónde está ahora: la app no ve su posición ni sus enfriamientos.',
  },
  {
    p: '¿Va a borrar mis páginas de runas?',
    r: 'No. La app crea sus propias páginas con el prefijo «Coach:». Si no te quedan páginas libres, solo reemplaza una que haya creado ella. Si no puede, te avisa y no toca nada.',
  },
  {
    p: '¿De dónde salen las builds?',
    r: `De partidas clasificatorias Solo/Dúo de jugadores Esmeralda o superior en EUW, LAN y LAS, que nuestro servidor descarga de la API oficial de Riot y agrega cada 6 horas. De esos mismos jugadores también descarga sus partidas de ARAM, ARAM: Caos y Arena. Cada build indica su número de partidas y su porcentaje de victorias. Una build se publica desde ${MIN_PARTIDAS_BUILD} partidas; de ${MIN_PARTIDAS_BUILD} a ${PARTIDAS_DATOS_LIMITADOS - 1} lleva la insignia «Datos limitados», y con menos de ${MIN_PARTIDAS_BUILD} la app dice «Build no disponible» en lugar de inventarse una.`,
  },
  {
    p: '¿Qué modos de juego admite?',
    r: 'Clasificatoria (por campeón y rol), ARAM y ARAM: Caos (por campeón, con runas, hechizos, objetos y habilidades; en ARAM: Caos, también los aumentos más elegidos) y Arena (por campeón, con los aumentos y objetos más elegidos y los de mejor posición media, y las cifras de posición media, top 4 y primer puesto). Cada modo tiene su tier list en el apartado Campeones. La app reconoce el modo en la selección de campeón y en la partida, y el overlay se adapta: en ARAM y ARAM: Caos quita los objetivos, el CS y la jungla, y deja el KDA, la flecha de habilidad y la compra; en Arena tampoco hay flecha de habilidad.',
  },
  {
    p: '¿Qué es la tier list de Campeones?',
    r: 'Un apartado de la app con todos los campeones por rol y modo. Cada uno recibe un tier (S, A, B o C) que combina su porcentaje de victorias y su uso dentro del rol. Los que tienen menos de 30 partidas nunca pasan de B y se marcan con «Datos limitados». Pulsa un campeón para ver su build completa.',
  },
  {
    p: '¿Necesito crear una cuenta?',
    r: 'No. Descargas la app, la abres junto al cliente de League of Legends y listo: no hay cuentas, claves ni registros.',
  },
  {
    p: '¿Qué pasa si me quedo sin conexión?',
    r: 'La app usa las últimas builds guardadas y te lo indica. El coach en partida funciona igual, porque solo necesita el cliente y la partida en tu equipo.',
  },
  {
    p: '¿Funciona en Mac o Linux?',
    r: 'Por ahora solo en Windows 10 y 11, que es donde se juega la gran mayoría de partidas de LoL. Mac y Linux quedan fuera de esta versión.',
  },
  {
    p: '¿Necesitas ayuda?',
    r: `Escríbenos a ${CORREO_SOPORTE}. Si el problema es con el overlay, indica tu versión de Windows y si el juego está en modo «Sin bordes».`,
    correo: true,
  },
  {
    p: '¿Coach LoL IA es un producto oficial de Riot?',
    r: 'No. Es un proyecto independiente que no está respaldado por Riot Games.',
  },
];
---

<Base>
  <!-- Hero -->
  <section class="hero" aria-labelledby="hero-titulo">
    <div class="hero-fondo" aria-hidden="true">
      {
        fondos.map((f, n) => (
          <img
            src={url(`img/splash-${f}.webp`)}
            srcset={`${url(`img/splash-${f}-800.webp`)} 800w, ${url(`img/splash-${f}.webp`)} 1600w`}
            sizes="100vw"
            alt=""
            width="1600"
            height="944"
            decoding="async"
            loading={n === 0 ? 'eager' : 'lazy'}
            fetchpriority={n === 0 ? 'high' : 'low'}
            style={`--n:${n}`}
          />
        ))
      }
    </div>
    <div class="contenedor hero-rejilla">
      <div class="hero-texto">
        <span class="etiqueta etiqueta-dorada">Nueva versión 3.0 · <a href={url('novedades')}>Novedades</a></span>
        <h1 id="hero-titulo">Coach LoL IA</h1>
        <p class="lema">{LEMA}</p>
        <p class="hero-desc">
          Builds de jugadores Esmeralda+ en la selección de campeón, importadas al cliente en un clic, una pantalla de
          carga con los dos equipos y un coach que te avisa durante la partida con un overlay por widgets y voz. Solo
          con las API oficiales de Riot.
        </p>
        <div class="hero-botones">
          <a class="boton boton-primario" href={url('descargar')}>
            <Icono nombre="descarga" tam={20} /> Descargar para Windows
          </a>
          <a class="boton boton-borde" href={url('apoyar')}>Apoya el proyecto</a>
        </div>
        <p class="hero-meta">Gratis · Windows 10/11 · Solo API oficiales de Riot · Código en <a href={URL_REPO} rel="noopener">GitHub</a></p>
      </div>
      <Captura
        clase="hero-captura"
        nombre="campeon"
        prioridad
        sizes="(max-width: 1000px) 100vw, 640px"
        alt="Captura de Coach LoL IA en la vista Campeón: Ahri en el rol Central con su porcentaje de victorias, 33 partidas y datos del parche 16.20, y el botón Importar; runas de Dominación y Brujería, hechizos Destello e Ignición, objetos de inicio, núcleo y botas, y la tabla del orden de habilidades con prioridad Q, W, E."
        pie="Vista Campeón con datos reales del servidor de builds."
      />
    </div>
    <div class="contenedor">
      <dl class="cifras">
        <div><dt>Regiones</dt><dd>EUW · LAN · LAS</dd></div>
        <div><dt>Partidas analizadas</dt><dd>Esmeralda+</dd></div>
        <div><dt>Refresco de builds</dt><dd>cada 6 h</dd></div>
        <div><dt>Pruebas automáticas</dt><dd>{PRUEBAS_AUTOMATICAS}</dd></div>
      </dl>
    </div>
  </section>

  <Seccion id="que-hace" antetitulo="Qué hace" titulo="Todo lo que necesitas, de la selección a la victoria">
    <p class="intro">
      Coach LoL IA te acompaña en los dos momentos que más cuentan: la selección de campeón, donde prepara tu build, y
      la partida, donde te recuerda lo importante sin que tengas que salir del juego.
    </p>
    <div class="rejilla funciones">
      {
        funciones.map((f) => (
          <article class="tarjeta">
            <div class="icono-caja"><Icono nombre={f.icono} /></div>
            <h3>
              {f.titulo}
            </h3>
            <p>{f.texto}</p>
          </article>
        ))
      }
    </div>
    <div class="vitrina">
      <div class="vitrina-texto">
        <h3>Tú decides qué te dice el coach</h3>
        <p>
          Desde la vista Overlay ves una vista previa de los widgets, eliges cuáles quieres, su tamaño y dónde van, y
          decides qué te dice la voz: objetivos, compras, habilidades, CS, visión, fases de la partida y jungla.
        </p>
        <ul class="lista-check">
          <li>Vista previa de los widgets tal y como se verán en partida</li>
          <li>«Mover y calibrar» para colocar cada widget donde no tape nada</li>
          <li>Opacidad general, y tamaño y un interruptor para cada widget</li>
          <li>Voz del sistema, volumen y qué avisos quieres oír, con «Probar voz»</li>
        </ul>
      </div>
      <Captura
        nombre="overlay-ajustes"
        alt="Captura de la vista Overlay de Coach LoL IA: vista previa con la barra de objetivos, el CS y el KDA, el aviso «Nivel 6: sube la R», la flecha sobre la R y el aviso de compra; a la derecha, el botón «Mover y calibrar», la opacidad y los interruptores y tamaños de los widgets Objetivos, Flecha de habilidad y Rendimiento (CS y KDA)."
        pie="Vista Overlay: widgets, posición, tamaño y voz."
      />
    </div>
  </Seccion>

  <Seccion id="novedades-3" antetitulo="Novedades de la 3.0" titulo="Antes, durante y entre partidas" alt>
    <p class="intro">
      La 3.0 suma la pantalla de carga, el apartado Campeones con su tier list, los modos ARAM, ARAM: Caos y Arena, y los
      temporizadores de jungla. Todo con datos que el juego o la API oficial de Riot ya ofrecen.
      <a href={url('novedades')}>Ver todas las novedades</a>.
    </p>
    <div class="vitrina">
      <div class="vitrina-texto">
        <h3>Pantalla de carga</h3>
        <p>
          Mientras carga la partida, el overlay coloca a los diez jugadores como el juego: los rivales arriba y tu equipo
          abajo. De cada uno ves el rango oficial de Solo/Dúo, la maestría con su campeón y las victorias de ese campeón en
          su rol.
        </p>
        <ul class="lista-check">
          <li>Etiquetas solo positivas o neutras: «Especialista en…», «Escala a final de partida»</li>
          <li>Sin MMR inventado ni etiquetas negativas para nadie</li>
          <li>Se oculta sola en cuanto empieza la partida</li>
        </ul>
      </div>
      <Captura
        nombre="carga"
        alt="Captura de la pantalla de carga en el overlay de Coach LoL IA: diez tarjetas de jugadores con nombres de ejemplo, cinco rivales arriba y cinco aliados abajo, cada una con el campeón, el rol, el rango (de Oro a Diamante, o Sin clasificar), las victorias y derrotas, la maestría, el porcentaje de victorias del campeón y etiquetas como «Especialista en Darius», «Racha positiva esta temporada» o «Protege a su equipo»."
        pie="Pantalla de carga con jugadores de ejemplo."
      />
    </div>
    <div class="vitrina vitrina-invertida">
      <div class="vitrina-texto">
        <h3>Campeones y tier list</h3>
        <p>
          Todos los campeones por rol, con su tier (S, A, B o C) según sus victorias y su uso, el número de partidas y la
          build completa con un clic. Un selector cambia entre Clasificatoria, ARAM, ARAM: Caos y Arena.
        </p>
        <ul class="lista-check">
          <li>Búsqueda, filtro por rol y orden por tier, victorias, uso o partidas</li>
          <li>Aviso «Datos limitados» en los que tienen menos de 30 partidas</li>
          <li>En Arena, posición media y porcentaje de top 4</li>
        </ul>
      </div>
      <Captura
        nombre="campeones"
        alt="Captura del apartado Campeones de Coach LoL IA: tier list de Clasificatoria con datos del parche 16.20, el selector de modo (Clasificatoria, ARAM, ARAM: Caos, Arena), la búsqueda, los filtros por rol y una tabla con el campeón, el rol, el tier, las victorias, el uso y las partidas; arriba, Yunara y Viego en tier S, y más abajo campeones en tier B con el aviso de datos limitados."
        pie="Apartado Campeones: tier list por modo y rol."
      />
    </div>
    <div class="vitrina vitrina-jungla">
      <div class="vitrina-texto">
        <h3>Temporizadores de jungla, a tu manera</h3>
        <p>
          Opcionales y apagados por defecto. Cuando limpias un campamento de tu lado o un Escarabajo, lo marcas con un clic
          o con tu tecla, y la app cuenta su reaparición encima del minimapa, como los del juego. Con Alt+Mayús+L los
          muestras u ocultas.
        </p>
        <ul class="lista-check">
          <li>Solo tu jungla y los dos Escarabajos: nunca los campamentos del rival</li>
          <li>Dorado en los últimos 30 segundos y una marca cuando el campamento ya está</li>
          <li>«El Gromp en 30 segundos» por voz, si lo quieres</li>
        </ul>
      </div>
      <Captura
        nombre="jungla-minimapa"
        alto={1600}
        sizes="(max-width: 1000px) 100vw, 440px"
        alt="Detalle de los temporizadores de jungla de Coach LoL IA sobre un minimapa esquemático del lado azul: cuentas atrás de 15 s y 1:40 en dos campamentos, 1:08 y 1:13 en otros dos, y una marca de verificación en los que ya han reaparecido."
        pie="Temporizadores sobre el minimapa (esquema del mapa)."
      />
    </div>
  </Seccion>

  <Seccion id="como-funciona" antetitulo="Cómo funciona" titulo="De la selección de campeón a la partida">
    <p class="intro">
      Sin configuración: abre la app antes o después del cliente y ella se encarga del resto.
    </p>
    <ol class="pasos">
      {
        pasos.map((p, i) => (
          <li class="paso">
            <span class="paso-num" aria-hidden="true">{i + 1}</span>
            <div>
              <span class="paso-detalle">{p.detalle}</span>
              <h3>{p.titulo}</h3>
              <p>{p.texto}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="overlay-bloque">
      <Captura
        nombre="overlay-partida"
        alt="Captura del overlay de Coach LoL IA sobre el arte de Jinx: arriba, la barra de objetivos (larvas ya disponibles, dragón en 0:38, Heraldo en 5:38 y Barón en 10:38); a la derecha, el CS (61, a 6,5 por minuto frente a un objetivo de 8); a la izquierda, el aviso «Nivel 6: sube la R»; abajo, una flecha sobre la R y el aviso «Ya puedes comprar Huracán de Runaan»."
        pie="Overlay en partida, con cada widget en su sitio."
      />
      <div>
        <h3>Qué te dice el coach en partida</h3>
        <dl class="avisos">
          {avisos.map(([tipo, ejemplo]) => (
            <div><dt>{tipo}</dt><dd>{ejemplo}</dd></div>
          ))}
        </dl>
        <p class="nota">
          Cada widget va a su sitio: los objetivos arriba, la flecha sobre tu barra de habilidades y el resto donde tú
          quieras. La voz dice una frase cada vez, la más urgente primero, y el mismo aviso no se repite hasta que su
          condición cambia. El CS se compara con una referencia de tu rol, sin colores rojos ni mensajes negativos.
        </p>
      </div>
    </div>

    <div class="overlay-bloque overlay-bloque-invertido">
      <div>
        <h3>El jungla enemigo, solo con lo que ya enseña el juego</h3>
        <p class="nota">
          Cuando el jungla enemigo participa en una muerte, el registro de muertes del juego lo muestra y la app te lo
          dice: «El jungla enemigo acaba de aparecer en bot (kill)». No es un seguimiento: la app no conoce su posición ni
          sus enfriamientos, y el aviso siempre habla de esa muerte.
        </p>
        <p class="nota">
          Si quieres, puedes activar una estimación de su ruta habitual (apagada por defecto): por qué lado suele empezar
          ese campeón y a qué calle suele ir primero, según nuestras partidas. Es lo que suele hacer, no lo que hace en tu
          partida.
        </p>
      </div>
      <Captura
        nombre="jungla-enemiga"
        alt="Captura del overlay de Coach LoL IA con el aviso «El jungla enemigo acaba de aparecer en bot (kill)», junto a la barra de objetivos, el CS, la flecha sobre la R, el aviso de compra y los temporizadores de jungla sobre un minimapa esquemático."
        pie="Aviso por el registro de muertes."
      />
    </div>
  </Seccion>

  <Seccion id="arquitectura" antetitulo="Arquitectura" titulo="Tres piezas que trabajan juntas" alt>
    <p class="intro">
      Un monorepo con la app de escritorio, el servidor de builds y esta web. La clave de la API de Riot
      vive solo en el servidor; la app distribuida no contiene ningún secreto.
    </p>
    <DiagramaArquitectura />
    <div class="rejilla piezas">
      <article class="tarjeta">
        <h3>App de escritorio</h3>
        <p>
          Electron con dos ventanas en React. El proceso principal reúne el <strong>conector LCU</strong> (cliente),
          el <strong>conector de partida</strong> (puerto 2999), el <strong>motor de consejos</strong> (una función pura
          y determinista: estado de partida + build + rol → avisos), el cliente de builds con caché en disco, los datos
          de Data Dragon.
        </p>
      </article>
      <article class="tarjeta">
        <h3>Servidor de builds</h3>
        <p>
          Node con Fastify y SQLite, empaquetado en Docker. El recolector descarga partidas de la API de Riot respetando
          sus límites de peticiones; el agregador calcula las builds cada 6 horas y la API pública las sirve como JSON
          con el parche y la fecha de cálculo.
        </p>
        <p><code>GET /builds/:campeon/:rol</code> · <code>GET /roles/:campeon</code> · <code>GET /salud</code></p>
      </article>
      <article class="tarjeta">
        <h3>Web y asistente</h3>
        <p>
          Esta web estática (Astro) se publica en GitHub Pages. Su asistente IA, igual que la vista Ayuda de la app,
          pregunta al servidor, que limita el uso y es el único que tiene la clave del modelo.
        </p>
      </article>
    </div>
  </Seccion>

  <Seccion id="seguridad" antetitulo="Seguridad y Vanguard" titulo="Solo API oficiales. Nunca tocamos el juego">
    <p class="intro">
      Vanguard es el sistema antitrampas de Riot y vigila el proceso del juego. Coach LoL IA está diseñada para no
      acercarse a él: todo lo que sabe lo obtiene de las interfaces que Riot publica para herramientas de terceros.
    </p>
    <div class="seguridad">
      <article class="tarjeta">
        <h3><Icono nombre="escudo" /> Lo que sí hace</h3>
        <ul class="lista-check">
          <li>Lee el <strong>lockfile</strong> del cliente para conectarse a la <strong>LCU API</strong>, una API local con contraseña.</li>
          <li>Consulta la <strong>Live Client Data API</strong> en <code>127.0.0.1:2999</code>, de solo lectura, durante la partida.</li>
          <li>Descarga nombres e iconos de <strong>Data Dragon</strong>, el servicio público de Riot.</li>
          <li>Muestra el overlay como una ventana normal de Windows, transparente y con clics pasantes.</li>
          <li>Registra la tecla rápida con el atajo global de Electron, sin enviar nada al juego.</li>
        </ul>
      </article>
      <article class="tarjeta">
        <h3><Icono nombre="ojo" /> Lo que nunca hace</h3>
        <ul class="lista-check lista-no">
          <li>Leer o escribir la memoria del juego.</li>
          <li>Inyectar código o DLL en ningún proceso.</li>
          <li>Hacer capturas de pantalla para analizarlas.</li>
          <li>Simular teclado o ratón, ni automatizar acciones.</li>
          <li>Borrar tus páginas de runas o tus conjuntos de objetos.</li>
        </ul>
      </article>
      <article class="tarjeta">
        <h3><Icono nombre="diana" /> Lo que el overlay no muestra</h3>
        <ul class="lista-check lista-no">
          <li>Temporizadores de hechizos de invocador o definitivas enemigas.</li>
          <li>Temporizadores de los campamentos de la jungla enemiga: los de jungla son solo de tu lado y los marcas tú.</li>
          <li>La posición de los enemigos o cualquier dato que no veas en pantalla. Del jungla enemigo solo repite lo que ya sale en el registro de muertes.</li>
        </ul>
        <p>Antes de pedir la clave de producción de Riot, cada aviso se revisa frente a la política vigente para desarrolladores.</p>
      </article>
    </div>
    <p class="nota">
      <strong>Tus datos:</strong> la clave de la API de Riot vive solo en el servidor como variable de entorno. La app
      nunca envía tus credenciales. Pide la build del campeón y el rol y, para la pantalla de carga, los identificadores
      de Riot de los diez jugadores, con los que el servidor consulta su rango y su maestría en la API oficial y los
      guarda en memoria un máximo de 10 minutos.
    </p>
  </Seccion>

  <Seccion id="datos" antetitulo="Datos" titulo="Builds de partidas reales, recalculadas cada 6 h" alt>
    <p class="intro">
      Las recomendaciones no son opiniones: salen de partidas clasificatorias recientes de jugadores de nivel alto,
      procesadas por nuestro propio servidor.
    </p>
    <ol class="tuberia">
      <li>
        <span class="tuberia-icono"><Icono nombre="usuario" /></span>
        <h3>Recolector</h3>
        <p>Usa League-v4 para encontrar jugadores <strong>Esmeralda o superior</strong> en <strong>EUW, LAN y LAS</strong>, y Match-v5 para descargar sus partidas <strong>clasificatorias Solo/Dúo</strong>, de <strong>ARAM</strong>, de <strong>ARAM: Caos</strong> y de <strong>Arena</strong>. Respeta los límites de Riot y procesa miles de partidas nuevas por región en cada ciclo, repartidas entre los modos; lo que un modo no llega a usar pasa a las clasificatorias.</p>
      </li>
      <li>
        <span class="tuberia-icono"><Icono nombre="grafico" /></span>
        <h3>Agregador</h3>
        <p>Para cada campeón y rol calcula la página de runas, los hechizos, los objetos iniciales, el núcleo de 3 objetos, las botas, los situacionales y el orden de habilidades más frecuentes, con su tasa de victorias y su número de partidas. En ARAM y ARAM: Caos agrupa por campeón, y en Arena añade los aumentos y la posición media. También calcula el tier de cada campeón en su rol.</p>
      </li>
      <li>
        <span class="tuberia-icono"><Icono nombre="reloj" /></span>
        <h3>Publicación</h3>
        <p>El ciclo se repite <strong>cada 6 h</strong>. La API sirve cada build con su parche y su fecha de cálculo, y la app la guarda en caché para usarla sin conexión.</p>
      </li>
    </ol>
    <div class="umbrales">
      <div class="umbral">
        <span class="umbral-cifra">200</span>
        <p><strong>partidas en el parche actual</strong> para usar solo datos del parche. Con menos de 200 partidas, se combinan con las del parche anterior y la build lo indica (<code>mezclaParches</code>).</p>
      </div>
      <div class="umbral">
        <span class="umbral-cifra">{MIN_PARTIDAS_BUILD}</span>
        <p><strong>{MIN_PARTIDAS_BUILD} partidas en total</strong> como mínimo para publicar una build. De {MIN_PARTIDAS_BUILD} a {PARTIDAS_DATOS_LIMITADOS - 1} partidas lleva la insignia <strong>«Datos limitados»</strong>, y con menos de {MIN_PARTIDAS_BUILD} la app muestra «Build no disponible» en lugar de inventarse una.</p>
      </div>
      <div class="umbral">
        <span class="umbral-cifra">6 h</span>
        <p><strong>entre actualizaciones.</strong> Cuando sale un parche nuevo, el servidor y Data Dragon se ponen al día solos y la app muestra «Datos del parche X.Y».</p>
      </div>
    </div>
  </Seccion>

  <Seccion id="tecnologias" antetitulo="Tecnologías" titulo="Un stack moderno, tipado de punta a punta">
    <p class="intro">
      Se descartaron Overwolf (obliga a instalar su plataforma) y Tauri (su overlay transparente con clics pasantes es
      menos maduro en Windows). Electron da el control necesario sobre el overlay con una sola base de código en
      TypeScript.
    </p>
    <ul class="tecnologias">
      {
        tecnologias.map((t) => (
          <li class="tarjeta">
            <h3>{t.nombre}</h3>
            <p>{t.uso}</p>
          </li>
        ))
      }
    </ul>
  </Seccion>

  <Seccion id="calidad" antetitulo="Calidad" titulo="Probado antes de cada cambio" alt>
    <div class="calidad">
      <div class="calidad-cifra">
        <span class="gran-cifra">{PRUEBAS_AUTOMATICAS}</span>
        <p>pruebas automáticas con Vitest en la app, el servidor y el código compartido, que se ejecutan en cada cambio.</p>
      </div>
      <div class="rejilla">
        <article class="tarjeta">
          <h3><Icono nombre="prueba" /> Pruebas con datos reales</h3>
          <p>El motor de consejos y el agregador se prueban con partidas grabadas. Un <strong>simulador de partida</strong> reproduce una partida real como Live Client Data API falsa y un <strong>LCU simulado</strong> permite probar la selección de campeón y la importación sin abrir LoL.</p>
        </article>
        <article class="tarjeta">
          <h3><Icono nombre="ramas" /> Integración continua</h3>
          <p>GitHub Actions comprueba los tipos de TypeScript de cada paquete y ejecuta todas las pruebas en Windows en cada push. También construye la imagen Docker del servidor y verifica que SQLite carga dentro de ella.</p>
        </article>
        <article class="tarjeta">
          <h3><Icono nombre="revisar" /> Revisión por tareas</h3>
          <p>Cada versión parte de una especificación y un plan dividido en tareas pequeñas. Cada tarea sigue TDD (primero una prueba que falla, luego el código) y pasa una revisión de especificación y otra de calidad antes de fusionarse.</p>
        </article>
        <article class="tarjeta">
          <h3><Icono nombre="rayo" /> Prueba real en partida</h3>
          <p>Antes de publicar cada versión se prueba en una partida de práctica real. Esta web también tiene sus pruebas: compilan el sitio y comprueban el HTML generado.</p>
        </article>
      </div>
    </div>
  </Seccion>

  <Seccion id="planes" antetitulo="Gratis" titulo="Gratis para todos">
    <p class="intro">
      Coach LoL IA es gratis y todo está incluido. No hay planes de pago, pruebas ni claves: todo el mundo tiene la
      misma app.
    </p>
    <div class="rejilla gratis">
      <article class="tarjeta">
        <div class="icono-caja"><Icono nombre="capas" /></div>
        <h3>Todo incluido</h3>
        <ul class="lista-check">
          <li>Builds de Esmeralda+ por campeón y rol</li>
          <li>Apartado Campeones con tier list</li>
          <li>Modos ARAM, ARAM: Caos y Arena, con aumentos</li>
          <li>Runas, hechizos, objetos y orden de habilidades</li>
          <li>Importación al cliente en un clic</li>
          <li>Pantalla de carga con los dos equipos</li>
          <li>Coach en partida: overlay por widgets, voz y temporizadores de jungla</li>
          <li>Asistente IA de soporte</li>
        </ul>
      </article>
      <article class="tarjeta">
        <div class="icono-caja"><Icono nombre="monitor" /></div>
        <h3>Sin anuncios dentro de la app</h3>
        <p>
          La app no tiene anuncios ni banners. El proyecto se financia con <strong>anuncios en la web</strong> (solo si
          aceptas las cookies publicitarias) y con <strong>donaciones voluntarias</strong>.
        </p>
      </article>
      <article class="tarjeta">
        <div class="icono-caja"><Icono nombre="usuario" /></div>
        <h3>Apoya el proyecto</h3>
        <p>
          Las donaciones pagan el servidor, los datos de las builds y el desarrollo. Son voluntarias y no dan ventajas:
          la app es igual para todos.
        </p>
        <p><a class="boton boton-borde" href={url('apoyar')}>Cómo apoyar</a></p>
      </article>
    </div>
  </Seccion>

  <div class="contenedor"><Anuncio /></div>

  <Seccion id="hoja-de-ruta" antetitulo="Hoja de ruta" titulo="Dónde estamos y hacia dónde vamos" alt>
    <ol class="ruta">
      {
        hojaDeRuta.map((h) => (
          <li class="tarjeta ruta-item">
            <div class="ruta-cabecera">
              <h3>{h.version}</h3>
              <span class:list={['etiqueta', h.clase]}>{h.estado}</span>
            </div>
            <ul class:list={['lista-check', { 'lista-punto': h.estado !== 'Completada' }]}>
              {h.puntos.map((p) => <li>{p}</li>)}
            </ul>
          </li>
        ))
      }
    </ol>
  </Seccion>

  <Seccion id="faq" antetitulo="FAQ" titulo="Preguntas frecuentes">
    <div class="faq">
      {
        faq.map((f) => (
          <details>
            <summary>{f.p}</summary>
            <p>{f.r}</p>
            {'correo' in f && (
              <p><a class="boton boton-borde" href={`mailto:${CORREO_SOPORTE}`}>Escribir a {CORREO_SOPORTE}</a></p>
            )}
          </details>
        ))
      }
    </div>
    <div class="faq-ayuda">
      <p>
        ¿No encuentras tu respuesta? Pregunta al <strong>asistente IA</strong>: está en el botón «Asistente IA» de esta web y en la
        vista «Ayuda» de la app.
      </p>
      <Captura
        nombre="ayuda"
        alt="Captura de la vista Ayuda de Coach LoL IA: el chat del asistente IA con su saludo, el campo «Escribe tu pregunta…», el botón Enviar y la nota de que las respuestas son generadas por IA."
      />
    </div>
  </Seccion>

  <section class="cta" aria-labelledby="cta-titulo">
    <div class="contenedor">
      <div class="cta-caja">
        <h2 id="cta-titulo">Tu próxima partida, con coach</h2>
        <p>Descarga Coach LoL IA gratis y prueba las builds en tu siguiente selección de campeón.</p>
        <div class="hero-botones">
          <a class="boton boton-primario" href={url('descargar')}><Icono nombre="descarga" tam={20} /> Descargar para Windows</a>
          <a class="boton boton-borde" href={url('apoyar')}>Apoya el proyecto</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding: clamp(48px, 7vw, 96px) 0 48px;
    background:
      radial-gradient(60% 50% at 80% 10%, rgb(79 124 255 / 0.18), transparent 70%),
      radial-gradient(50% 40% at 10% 0%, rgb(200 170 110 / 0.12), transparent 70%);
    overflow: hidden;
  }
  .hero-rejilla {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    gap: 48px;
    align-items: center;
  }
  .hero h1 {
    font-size: clamp(2.6rem, 6vw, 4.4rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    margin: 18px 0 10px;
    background: linear-gradient(180deg, #fff 30%, var(--dorado-claro));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lema {
    font-size: clamp(1.15rem, 2.2vw, 1.45rem);
    font-weight: 600;
    margin-bottom: 14px;
  }
  .hero-desc {
    color: var(--texto-suave);
    font-size: 1.06rem;
    max-width: 52ch;
  }
  .hero-botones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 26px 0 16px;
  }
  .hero-meta {
    color: var(--texto-suave);
    font-size: 0.88rem;
  }
  .hero-rejilla :global(.hero-captura .marco) {
    transform: perspective(1600px) rotateY(-5deg) rotateX(2deg);
    transition: transform 400ms ease;
  }
  .hero-rejilla :global(.hero-captura:hover .marco) {
    transform: none;
  }
  .hero-fondo {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }
  .hero-fondo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    filter: brightness(1.2) saturate(1.1);
    opacity: 0;
    animation: fundido 27s infinite;
    animation-delay: calc((var(--n) - 1) * 9s + 4s);
  }
  .hero-fondo img:first-child {
    opacity: 1;
    animation: none;
  }
  .hero-rejilla :global(.hero-captura figcaption) {
    width: fit-content;
    padding: 6px 12px 6px 6px;
    border-radius: 999px;
    background: rgb(10 14 26 / 0.8);
    color: var(--texto);
  }
  .hero-fondo::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(10 14 26 / 0.92) 0%, rgb(10 14 26 / 0.68) 32%, rgb(10 14 26 / 0.25) 62%, rgb(10 14 26 / 0.4) 100%),
      linear-gradient(180deg, rgb(10 14 26 / 0.3) 0%, rgb(10 14 26 / 0.1) 35%, rgb(10 14 26 / 0.75) 75%, var(--fondo) 100%);
  }
  /* La primera imagen queda fija debajo; las demás aparecen por turnos encima. */
  @keyframes fundido {
    0% { opacity: 0; }
    5%, 28% { opacity: 1; }
    33%, 100% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-fondo img {
      animation: none;
    }
  }
  figcaption {
    display: flex;
    align-items: center;
