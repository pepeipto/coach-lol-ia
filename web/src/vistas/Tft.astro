---
// Página de TFT: qué hace la pestaña TFT de la app, con capturas, y qué hace (y qué no) la app durante la partida.
// Las composiciones y los objetos no se publican aquí: se ven en la app. Política de Riot: en TFT nada en partida,
// ni aumentos ni Leyendas.
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import Base from '../layouts/Base.astro';
import Captura from '../components/Captura.astro';
import Icono from '../components/Icono.astro';
import { canonica, INFO, md, ruta, t, type Idioma } from '../i18n';
import { resumenTft } from '../lib/tft';

interface Props {
  lang: Idioma;
}
const { lang } = Astro.props;
const tx = t(lang);
const f = tx.tft;
const ov = tx.inicio.comoFunciona.overlay;
const foto = tx.inicio.enAccion.fotos[0];
const h = (s: string) => md(s, lang);
const quitarEnlaces = (s: string) => s.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1').replace(/\*\*/g, '');
const datos = await resumenTft();
const num = (x: number) => x.toLocaleString(INFO[lang].hreflang);
// Capturas reales de la pestaña TFT (public/capturas/tft-*.webp); si aún no están, la sección sale sin ellas.
const hayCaptura = (n: string) => existsSync(resolve(process.cwd(), 'public', 'capturas', `${n}.webp`));
const capturasTft = [
  { nombre: 'tft-composiciones', ...f.capturas.lista },
  { nombre: 'tft-objetos', ...f.capturas.objetos },
].filter((c) => hayCaptura(c.nombre));
const jsonld = [
  {
    '@type': 'WebPage',
    name: tx.meta.paginas.tft.titulo,
    description: tx.meta.paginas.tft.descripcion,
    url: canonica(lang, 'tft'),
    inLanguage: INFO[lang].hreflang,
    isPartOf: { '@id': 'https://www.coachlolia.com/#web' },
    about: { '@id': 'https://www.coachlolia.com/#app' },
  },
  {
    '@type': 'FAQPage',
    inLanguage: INFO[lang].hreflang,
    mainEntity: f.faq.map((x) => ({
      '@type': 'Question',
      name: x.p,
      acceptedAnswer: { '@type': 'Answer', text: quitarEnlaces(x.r) },
    })),
  },
];
---

<Base lang={lang} pagina="tft" jsonld={jsonld} migas={[{ nombre: f.antetitulo, href: canonica(lang, 'tft') }]}>
  <article class="pagina">
    <div class="contenedor">
      <header class="cabeza">
        <span class="antetitulo">{f.antetitulo}</span>
        <h1>{f.h1}</h1>
        <p class="intro" set:html={h(f.intro)} />
        {datos && <p class="datos">{f.datos.replace('{parche}', datos.parche).replace('{partidas}', num(datos.partidas))}</p>}
        <a class="boton boton-primario" href={ruta(lang, 'descargar')}><Icono nombre="descarga" tam={20} /> {tx.comun.descargarWindows}</a>
      </header>

      {
        capturasTft.length > 0 && (
          <div class:list={['capturas-tft', capturasTft.length === 1 && 'una']}>
            {capturasTft.map((c, n) => (
              <Captura nombre={c.nombre} alt={c.alt} pie={c.pie} lang={lang} prioridad={n === 0} sizes="(max-width: 1000px) 100vw, 560px" />
            ))}
          </div>
        )
      }

      <section class="funciones" aria-labelledby="funciones-tft">
        <h2 id="funciones-tft">{f.funciones.titulo}</h2>
        <ul class="rejilla-funciones">
          {
            f.funciones.lista.map((x) => (
              <li class="tarjeta">
                <h3>{x.titulo}</h3>
                <p>{x.texto}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="tarjeta honestidad" aria-labelledby="partida-tft">
        <h2 id="partida-tft">{f.partida.titulo}</h2>
        <p set:html={h(f.partida.texto)} />
      </section>

      <section class="lol" aria-labelledby="overlay-lol">
        <h2 id="overlay-lol">{f.lol.titulo}</h2>
        <p class="intro-lol">{f.lol.texto}</p>
        <div class="overlay-bloque">
          <Captura nombre="overlay-partida" alt={ov.alt} pie={ov.pie} lang={lang} />
          <div>
            <h3>{ov.titulo}</h3>
            <dl class="avisos">
              {ov.avisos.map(([tipo, ejemplo]) => <div><dt>{tipo}</dt><dd>{ejemplo}</dd></div>)}
            </dl>
          </div>
        </div>
        <div class="overlay-bloque invertido">
          <p class="nota">{ov.nota}</p>
          <Captura nombre={foto.nombre} alto={900} alt={foto.alt} pie={foto.pie} lang={lang} />
        </div>
        <p><a href={ruta(lang, 'guiaOverlay')}>{tx.inicio.seguridad.guia} →</a></p>
      </section>

      <section class="faq-tft" aria-labelledby="faq-tft">
        <h2 id="faq-tft">{tx.inicio.faq.titulo}</h2>
        {
          f.faq.map((x) => (
            <details>
              <summary>{x.p}</summary>
              <p set:html={h(x.r)} />
            </details>
          ))
        }
      </section>

      <p class="ia">{f.ia}</p>

      <div class="cta-final tarjeta">
        <p>{f.cta}</p>
        <a class="boton boton-primario" href={ruta(lang, 'descargar')}><Icono nombre="descarga" tam={20} /> {tx.comun.descargarWindows}</a>
      </div>
    </div>
  </article>
</Base>

<style>
  .cabeza {
    max-width: 860px;
  }
  .cabeza h1 {
    font-size: clamp(2rem, 4vw, 2.8rem);
  }
  .datos {
    color: var(--dorado-claro);
    font-weight: 600;
  }
  .capturas-tft {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
    margin-top: 48px;
  }
  .capturas-tft.una {
    grid-template-columns: minmax(0, 860px);
  }
  .funciones,
  .lol,
  .honestidad {
    margin-top: 56px;
  }
  .funciones h2,
  .lol h2,
  .honestidad h2,
  .faq-tft h2 {
    font-size: 1.35rem;
  }
  .rejilla-funciones {
    list-style: none;
    padding: 0;
    margin: 20px 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
    gap: 16px;
  }
  .rejilla-funciones h3 {
    margin: 0 0 6px;
    font-size: 1.05rem;
    color: var(--dorado-claro);
  }
  .rejilla-funciones p,
  .honestidad p,
  .intro-lol,
  .nota {
    color: #c9d0e2;
    margin: 0;
  }
  .honestidad {
    border-color: rgb(200 170 110 / 0.45);
    max-width: 860px;
  }
  .intro-lol {
    max-width: 860px;
  }
  .overlay-bloque {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 40px;
    align-items: center;
    margin-top: 32px;
  }
  .overlay-bloque.invertido {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
  }
  .overlay-bloque h3 {
    margin-top: 0;
  }
  .avisos {
    margin: 0;
  }
  .avisos div {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--borde);
  }
  .avisos dt {
    font-weight: 600;
    color: var(--dorado-claro);
    font-size: 0.92rem;
  }
  .avisos dd {
    margin: 0;
    color: #c9d0e2;
    font-size: 0.93rem;
  }
  .lol > p:last-child {
    margin-top: 24px;
  }
  .faq-tft {
    max-width: 860px;
    margin-top: 56px;
  }
  .faq-tft details {
    border: 1px solid var(--borde);
    background: var(--superficie);
    border-radius: var(--radio-grande);
    margin-bottom: 10px;
  }
  .faq-tft summary {
    cursor: pointer;
    padding: 16px 20px;
    font-weight: 600;
  }
  .faq-tft details p {
    padding: 0 20px 16px;
    margin: 0;
    color: #c9d0e2;
  }
  .ia {
    margin-top: 24px;
    font-size: 0.8rem;
    color: #9aa3b8;
  }
  .cta-final {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
  }
  .cta-final p {
    margin: 0;
  }
  @media (max-width: 1000px) {
    .capturas-tft,
    .overlay-bloque,
    .overlay-bloque.invertido {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
    .overlay-bloque.invertido .nota {
      order: 2;
    }
  }
  @media (max-width: 560px) {
    .avisos div {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
</style>
