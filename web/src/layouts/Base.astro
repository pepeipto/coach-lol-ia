---
import '@fontsource-variable/inter';
import '../styles/global.css';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import BannerCookies from '../components/BannerCookies.astro';
import { NOMBRE, LEMA, ADSENSE_CLIENT } from '../lib/sitio';

interface Props {
  titulo?: string;
  descripcion?: string;
  /** Páginas de pago: nunca cargan AdSense ni el banner de anuncios. */
  sinAnuncios?: boolean;
  /** No indexar (páginas de gracias y gestión). */
  noIndexar?: boolean;
}

const {
  titulo,
  descripcion = `${NOMBRE}: builds de jugadores Esmeralda+ en la selección de campeón y un coach en partida con overlay y voz, todo en español. Solo usa las API oficiales de Riot.`,
  sinAnuncios = false,
  noIndexar = false,
} = Astro.props;

const tituloCompleto = titulo ? `${titulo} · ${NOMBRE}` : `${NOMBRE}: ${LEMA}`;
// GitHub Pages sirve cada página como carpeta: la URL canónica termina siempre en «/».
const ruta = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonica = new URL(ruta, Astro.site);
const favicon = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`;
const anuncios = Boolean(ADSENSE_CLIENT) && !sinAnuncios;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <meta name="theme-color" content="#0a0e1a" />
    {noIndexar && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={NOMBRE} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Cabecera />
    <main id="contenido">
      <slot />
    </main>
    <Pie />
    {anuncios && <BannerCookies cliente={ADSENSE_CLIENT} />}
  </body>
</html>
