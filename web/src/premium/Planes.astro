---
// Planes y cuotas (nov. 2026). Los datos salen de shared/src/planes.ts, el mismo catálogo que usa el servidor.
import { formatearEuros, PAQUETES, PLANES, PLANES_DE_PAGO } from '../../../shared/src/planes';
import { url } from '../lib/sitio';

interface Props {
  /** 'resumen' en la portada; 'compra' en /premium (botones Suscribirme). */
  modo?: 'resumen' | 'compra';
}
const { modo = 'resumen' } = Astro.props;

const incluido = 'Builds, runas, importación, overlay y coach por voz en partida';
const descripcion: Record<string, string> = {
  gratis: 'Todo lo de la app, sin pagar nada.',
  aliado: 'Apoya el proyecto y analiza más partidas.',
  estratega: 'Para quien juega casi a diario.',
  mariscal: 'Doble de partidas y preguntas.',
  leyenda: 'Para jugar mucho o en varias cuentas.',
};
const planes = [PLANES.gratis, ...PLANES_DE_PAGO.map((id) => PLANES[id])];
---

<div class="planes">
  {
    planes.map((p) => (
      <article class:list={['plan', { 'plan-premium': p.id === 'estratega' }]} aria-labelledby={`plan-${p.id}-${modo}`}>
        {p.id === 'estratega' && <span class="etiqueta etiqueta-dorada destacado">Recomendado</span>}
        <h3 id={`plan-${p.id}-${modo}`}>{p.nombre}</h3>
        <p class="precio">
          <span class="cifra">{formatearEuros(p.centimosMes)}</span> <span class="periodo">{p.centimosMes ? '/mes' : 'sin pagar nada'}</span>
        </p>
        {p.centimosAnio && (
          <p class="precio-anual">
            o <strong>{formatearEuros(p.centimosAnio)}/año</strong> <span class="etiqueta etiqueta-exito ahorro">2 meses gratis</span>
          </p>
        )}
        <p class="plan-desc">{descripcion[p.id]}</p>
        <ul class="lista-check">
          <li>{incluido}</li>
          <li>{p.cuota.partida} partidas con coach IA al mes</li>
          <li>{p.cuota.pregunta} preguntas a tu coach al mes</li>
          {p.paquetes && <li>Paquetes de partidas extra</li>}
          {p.id === 'aliado' && <li>Insignia de apoyo</li>}
        </ul>
        {p.id === 'gratis' ? (
          <a class="boton boton-borde" href={url('descargar')}>Descargar gratis</a>
        ) : modo === 'compra' ? (
          <div class="botones-plan">
            <button type="button" class="boton boton-dorado" data-plan={p.id}>Suscribirme</button>
            {p.centimosAnio && (
              <button type="button" class="boton boton-borde" data-plan={p.id} data-periodo="anio">
                Pagar un año ({formatearEuros(p.centimosAnio)})
              </button>
            )}
          </div>
        ) : (
          <a class="boton boton-dorado" href={url('premium')}>Ver planes</a>
        )}
      </article>
    ))
  }
</div>
<p class="plan-nota-general">
  La cuota se renueva cada mes el día que te suscribes y no se acumula, también en el pago anual. Lo que te ayuda durante la partida es gratis en todos
  los planes; los planes de pago solo dan más coach con IA.
</p>
{
  modo === 'compra' && (
    <p class="plan-nota-general">
      Partidas extra (pago único, planes Estratega, Mariscal y Leyenda, no caducan):{' '}
      {Object.values(PAQUETES)
        .map((x) => `${x.partidas} por ${formatearEuros(x.centimos)}`)
        .join(' · ')}
      . Se compran desde «Gestionar suscripción».
    </p>
  )
}

<style>
  .planes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 18px;
    margin-top: 36px;
  }
  .plan {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-radius: var(--radio-grande);
    padding: 26px 22px;
  }
  .plan-premium {
    border-color: rgb(200 170 110 / 0.6);
    background:
      radial-gradient(120% 60% at 100% 0%, rgb(200 170 110 / 0.12), transparent 60%),
      var(--superficie);
    box-shadow: 0 30px 80px -40px rgb(200 170 110 / 0.35);
  }
  .destacado {
    position: absolute;
    top: 14px;
    right: 14px;
  }
  h3 {
    font-size: 1.2rem;
    margin-bottom: 0.3em;
  }
  .precio {
    margin: 0 0 0.4em;
  }
  .cifra {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .plan-premium .cifra {
    color: var(--dorado-claro);
  }
  .periodo,
  .plan-desc,
  .plan-nota-general {
    color: var(--texto-suave);
  }
  .plan ul {
    margin-bottom: 18px;
  }
  .plan .boton,
  .botones-plan {
    margin-top: auto;
  }
  .botones-plan {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .botones-plan .boton {
    margin-top: 0;
  }
  .precio-anual {
    margin: 0 0 0.6em;
    font-size: 0.92rem;
    color: var(--texto-suave);
  }
  .precio-anual strong {
    color: var(--texto);
  }
  .ahorro {
    font-size: 0.75rem;
    margin-left: 4px;
  }
  .plan-nota-general {
    font-size: 0.9rem;
    margin-top: 18px;
  }
</style>
