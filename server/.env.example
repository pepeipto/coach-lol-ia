RIOT_API_KEY=
PUERTO=8080
RUTA_DB=/datos/coach.db
# Suscripciones (Stripe). Si falta alguna de las tres, las rutas /api/premium/* responden 503.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
URL_WEB=https://www.coachlolia.com
# Número de proxies inversos de confianza delante del servidor (1-5; en Fly.io, 1). Vacía si no hay proxy.
TRUST_PROXY=
# Sal del hash de las IP con que se limita la prueba gratuita (una por IP cada 30 días). Vacía: se genera y guarda en la base.
PRUEBA_SAL=
# Asistente de soporte con IA (POST /api/asistente). Sin clave responde 503 asistente_no_configurado.
ANTHROPIC_API_KEY=
# Opcional: otro modelo para el asistente (por defecto claude-opus-5-5).
ASISTENTE_MODELO=
