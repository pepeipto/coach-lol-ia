RIOT_API_KEY=
PUERTO=8080
RUTA_DB=/datos/coach.db
# Suscripciones (Stripe). Si falta alguna de las tres, las rutas /api/premium/* responden 503.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
URL_WEB=https://www.coachlolia.com
# 1 o true si el servidor está detrás de un proxy inverso: así el límite de peticiones es por cliente y no global.
TRUST_PROXY=
